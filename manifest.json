{
  "manifest_version": 3,
  "name": "Browser Agent Pro",
  "version": "0.1.0",
  "description": "多模态浏览器自主操作 Agent：自然语言驱动的浏览器自动化与网页认知",
  "permissions": ["storage", "activeTab", "scripting", "tabs", "sidePanel", "alarms"],
  "host_permissions": ["https://api.moonshot.cn/*", "<all_urls>"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "action": {
    "default_title": "Browser Agent Pro"
  },
  "options_page": "options/options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src http: https: data:"
  }
}
